pipeline {
    agent any
    environment {
        IMAGE="ajs3ra8/testing"
        TAG="${BUILD_NUMBER}"
    }
    stages {
        stage ('Build') {
            steps {
                sh 'docker build -t "$IMAGE:$TAG" -t "$IMAGE:latest" .'
            }
        }
        stage ('Push') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'docker-cred', passwordVariable: 'DOCKER_PWD', usernameVariable: 'DOCKER_UNAME')]) {
                sh 'echo $DOCKER_PWD | docker login -u $DOCKER_UNAME --password-stdin'
                sh 'docker push "$IMAGE:$TAG"'
                sh 'docker push "$IMAGE:latest"'
        }

            }
        }
        stage('Deploy') {
            steps {
                echo "Deploying the code"
                sh '''
                cat > deploy-info-${BUILD_NUMBER}.txt <<EOF
                build: $BUILD_NUMBER
                image: $IMAGE:$TAG
                commit: $GIT_COMMIT
                branch: $GIT_BRANCH
                time: $(date -u +"%Y-%m-%dT%H:%M:%SZ")
                url: $BUILD_URL
                EOF
                '''

                archiveArtifacts artifacts: "deploy-info-${BUILD_NUMBER}.txt", defaultExcludes: false, fingerprint: true, followSymlinks: false, onlyIfSuccessful: true
            }
        }
        stage ('Test') {
            steps {
                sh 'sleep 2; echo "Hit http://localhost:5000 to see the app"'
            }
        }
        stage ('Clean workspace') {
            steps {
                cleanWs()
            }
        }
    }
    post {
        success {
            echo "Build ${env.BUILD_NUMBER} succeeded"
        }
        failure {
            echo "Build ${env.BUILD_NUMBER} failed"
        }
        always {
            echo "Build ${env.BUILD_NUMBER} finished"
        }
    }
}